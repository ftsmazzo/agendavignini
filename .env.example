# Banco local. Não use esta senha fora da máquina de desenvolvimento.
DATABASE_URL=postgres://agendavignini:agendavignini@localhost:5432/agendavignini
# Segredo da sessão. Troque por um valor longo e aleatório.
SESSION_SECRET=troque-por-um-segredo-longo-de-32-caracteres
# Caixa de saída do resumo da manhã. Sem estes valores o resumo fica só na tela.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_FROM_NAME=Agenda Coelho Vignini
# Chave longa (16 ou mais) para GET /cron/resumo, no cabeçalho Authorization: Bearer.
# CRON_SECRET=
# URL pública do app (para o JSON de conexão do MCP no admin).
# APP_URL=https://agendavignini-app.kxryyk.easypanel.host
# Token mestre opcional do MCP (somente leitura). Tokens por integração ficam no admin.
# MCP_TOKEN=
